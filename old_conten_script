(async function () {
    let elementGone = false;
    let wordObserver = null;
    let isTyping = false;

    // 💤 Utility: Sleep for delay
    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    // 🧠 Typing Function with human-like behavior
    async function typeTextIntoInput(inputEl, text) {
        if (isTyping) {
            console.log("⚠️ Typing already in progress, skipping...");
            return;
        }

        isTyping = true;
        inputEl.focus();
        inputEl.value = "";
        let index = 0;

        async function typeNextChar() {
            if (index < text.length) {
                let char = text[index];
                let typo = false;

                // 🔀 10% chance for wrong character
                if (Math.random() < 0.02) {
                    const wrongChar = String.fromCharCode(97 + Math.floor(Math.random() * 26));
                    inputEl.value += wrongChar;
                    inputEl.dispatchEvent(new Event("input", { bubbles: true }));
                    console.log(`🤕 Wrong char '${wrongChar}' typed`);

                    await sleep(300);

                    // 🔁 Remove wrong char
                    inputEl.value = inputEl.value.slice(0, -1);
                    inputEl.dispatchEvent(new Event("input", { bubbles: true }));

                    await sleep(100);

                    // ✅ Type correct char
                    inputEl.value += char;
                    inputEl.dispatchEvent(new Event("input", { bubbles: true }));

                    typo = true;
                } else {
                    // ✅ Type correct char
                    inputEl.value += char;
                    inputEl.dispatchEvent(new Event("input", { bubbles: true }));
                }

                index++;

                const delay = Math.floor(Math.random() * 70) + 20; // 80–150ms
                await sleep(typo ? delay + 200 : delay);

                await typeNextChar(); // 🔁 next char
            } else {
                // ✅ Add space at end
                await sleep(150);
                inputEl.value += " ";
                inputEl.dispatchEvent(new Event("input", { bubbles: true }));
                isTyping = false;
                console.log("✅ Typing completed with space!");
            }
        }

        await typeNextChar();
    }

    function waitFor(selector, intervalTime = 300) {
        return new Promise((resolve) => {
            const interval = setInterval(() => {
                const el = document.querySelector(selector);
                if (el) {
                    clearInterval(interval);
                    resolve(el);
                }
            }, intervalTime);
        });
    }

    function waitUntilElementGone(selector, intervalTime = 300) {
        return new Promise((resolve) => {
            const interval = setInterval(() => {
                const el = document.querySelector(selector);
                if (!el) {
                    clearInterval(interval);
                    elementGone = true;
                    console.log(`✅ '${selector}' gone from page`);
                    resolve();
                }
            }, intervalTime);
        });
    }

    async function startTypingCycle() {
        try {
            console.log("🔄 Starting new typing cycle...");

            const wordContainer = await waitFor(".hideableWords.unselectable");
            const inputBox = await waitFor(".txtInput");
            const hiddenSpan = wordContainer.querySelector("span");
            if (!hiddenSpan) throw new Error("❌ No span found.");

            elementGone = false;

            console.log("⏳ Waiting for countdown to finish...");
            await waitUntilElementGone(".countdownPopup.horizontalCountdownPopup");
            console.log("✅ Countdown finished, starting typing.");

            if (wordObserver) {
                wordObserver.disconnect();
                console.log("♻️ Disconnected previous word observer");
            }

            const initialText = hiddenSpan.innerText.trim();
            if (initialText) {
                console.log("📝 Initial word:", initialText);
                await typeTextIntoInput(inputBox, initialText);
            }

            wordObserver = new MutationObserver(() => {
                const newText = hiddenSpan.innerText.trim();
                if (newText && elementGone && !isTyping) {
                    console.log("🔁 New word detected:", newText);
                    typeTextIntoInput(inputBox, newText);
                }
            });

            wordObserver.observe(hiddenSpan, {
                childList: true,
                characterData: true,
                subtree: true,
            });

        } catch (err) {
            console.error("❌ Error in typing cycle:", err);
        }
    }

    const countdownObserver = new MutationObserver((mutationsList) => {
        for (const mutation of mutationsList) {
            if (mutation.addedNodes.length > 0) {
                mutation.addedNodes.forEach(node => {
                    if (
                        node.nodeType === 1 &&
                        node.matches &&
                        node.matches(".countdownPopup.horizontalCountdownPopup")
                    ) {
                        console.log("🕒 New countdown detected!");
                        startTypingCycle();
                    }
                });
            }
        }
    });

    countdownObserver.observe(document.body, { childList: true, subtree: true });

    // 🔁 Start first cycle
    startTypingCycle();
})();
